PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=hotel_db
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# SMTP Configuration (for Nodemailer)
